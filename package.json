{
  "name": "dual-city-food-map",
  "version": "1.0.0",
  "private": true,
  "description": "北京与上海共用门店、地点解析及直线距离排序的高德地图和 MCP",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node amap-server.cjs",
    "test": "node --test acceptance.test.cjs server.test.cjs mcp.acceptance.test.cjs image.acceptance.test.cjs dual-city.acceptance.test.cjs && node --test beijing-food-map/acceptance.test.cjs beijing-food-map/server.test.cjs deployment/worker.test.mjs && node --test content.acceptance.test.cjs content.http.test.cjs content.integration.test.cjs home-cards.acceptance.test.cjs",
    "test:page": "playwright test",
    "test:all": "npm test && npm run test:page",
    "test:live": "playwright test --config playwright.live.config.cjs",
    "test:codex": "node scripts/codex-acceptance.cjs",
    "sources:verify": "node scripts/verify-sources.cjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "content:build": "node scripts/build-content.cjs",
    "test:content:page": "playwright test --config playwright.content.config.cjs",
    "start:home": "node beijing-food-map/amap-server.cjs",
    "test:home": "playwright test --config playwright.home.config.cjs",
    "test:content:integration": "playwright test --config playwright.integration.config.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "esbuild": "0.28.2",
    "undici": "7.30.2"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  }
}
